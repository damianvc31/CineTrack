# =====================================================================
# CineTrack — .gitignore
# Stack: Python (FastAPI) + React (Vite + TS) + PostgreSQL / SQLite
# =====================================================================

# --- Secretos y variables de entorno (NUNCA subir a git) ---
.env
.env.local
.env.*.local
.env.*
!.env.example

# --- Python / FastAPI / Entornos virtuales ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.installed.cfg
*.manifest
*.spec

# Entornos virtuales (raíz y backend/)
.venv/
backend/.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Bases de datos locales / SQLite / Testing ---
*.sqlite
*.sqlite3
*.db
*.db.bak
*.db-journal
*.db-shm
*.db-wal
*.dump
*.sql.gz

# --- Herramientas de testing, tipado y linters (Python) ---
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Node / React / Vite (Frontend) ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
build/
.vite/
frontend/.vite/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / Sistema Operativo ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Scratch / scripts temporales
scratch/
**/scratch/