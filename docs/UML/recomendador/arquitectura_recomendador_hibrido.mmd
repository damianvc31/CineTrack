flowchart TD
    %% =========================================================================
    %% CINETRACK — ARQUITECTURA DEL RECOMENDADOR HÍBRIDO CON CONTROL DE VARIEDAD
    %% Flujo End-to-End: Frontend Slider, RAG Multicapa, Modulación de Votos,
    %% Reasoning Dispatcher y Cascada de Resiliencia Multi-Key.
    %% =========================================================================

    classDef client fill:#1f2937,stroke:#f59e0b,stroke-width:2px,color:#fff;
    classDef api fill:#111827,stroke:#3b82f6,stroke-width:2px,color:#fff;
    classDef service fill:#1e1e2e,stroke:#10b981,stroke-width:2px,color:#fff;
    classDef db fill:#261b36,stroke:#8b5cf6,stroke-width:2px,color:#fff;
    classDef ai fill:#2d1a29,stroke:#ec4899,stroke-width:2px,color:#fff;
    classDef fallback fill:#371c1c,stroke:#ef4444,stroke-width:2px,color:#fff;

    subgraph CLIENTE["Capas Frontend (React)"]
        UI["RecommendationsPage"]:::client
        SLIDER["VarietySlider (5 Niveles:\nVERY_LOW · LOW · MEDIUM · HIGH · VERY_HIGH)"]:::client
        PRESETS["Presets Dinámicos"]:::client
        UI --> SLIDER
        UI --> PRESETS
    end

    subgraph BACKEND["Capa de Backend (FastAPI)"]
        ENDPOINT["POST /api/v1/recommendations\n{prompt, variety_level?, apply_user_profile}"]:::api
        AUTH["Contexto de Usuario\n(Favoritos, Vistos, Reseñas,\npreferencia_variedad_ia)"]:::api
        ENDPOINT --> AUTH
    end

    subgraph RAG_ENGINE["Motor Híbrido RAG (ai_recommender_service)"]
        VALIDATOR["Paso 1: Validador Determinista\n(Filtra texto incoherente / longitud)"]:::service
        EXTRACTOR["Paso 2: Extractor LLM Ligero (Gemini/Groq)\nFiltros duros, exclusiones y detección de entidades"]:::ai
        EMBEDDING["Generador de Embeddings\nGoogle text-embedding-004 (768d)"]:::ai
        
        VARIETY_MOD["Paso 3: Modulación por Variedad\n- Multiplicador de votos (1.8x a 0.3x)\n- Filtro aclamados (rating >= 7.5 en VERY_LOW)\n- Exención para entidades directas\n- Starvation guardrail (candidatos < 3)"]:::service

        VALIDATOR -->|Prompt válido| EXTRACTOR
        EXTRACTOR -->|Vector semántico| EMBEDDING
        EXTRACTOR -->|Filtros + Entidades| VARIETY_MOD
        EMBEDDING --> VARIETY_MOD
    end

    subgraph PERSISTENCIA["Bases de Datos (Neon Postgres)"]
        DB_TITULOS[(titulos + vector_embedding 768d)]:::db
        DB_ACTORES[(actores / elenco)]:::db
        DB_ESTADOS[(estados_usuario + resenas)]:::db
        
        SQL_QUERY["Búsqueda SQL Híbrida\nWHERE filtros_modulados\nORDER BY pgvector cosine distance"]:::db
        
        VARIETY_MOD --> SQL_QUERY
        SQL_QUERY --> DB_TITULOS
        SQL_QUERY --> DB_ACTORES
        AUTH -.-> SQL_QUERY
    end

    subgraph DISPATCHER["Reasoning Dispatcher & Resiliencia Multi-Key"]
        PROMPT_BUILDER["Paso 4: Grounding Final\nInyecta Top 20 candidatos + contexto usuario\n+ directivas semánticas de variedad"]:::service
        
        ROUTER{"Tipo de Modelo\n(AI_REASONING_MODELS)"}:::service
        
        LLM_REASONING["Modelos Reasoning (qwen / gpt-oss)\n- reasoning_effort: low | medium | high\n- Temperatura modulada (0.7 a 1.2)"]:::ai
        LLM_STANDARD["Modelos Standard (Gemini Flash)\n- Temperatura modulada (0.7 a 1.2)"]:::ai
        
        CASCADE["Cascada Multi-Key:\nGemini (Key 1 -> Key 2) ->\nGroq (Key 1 -> Key 2)"]:::ai
        L3_FALLBACK["Fallback Heurístico Nivel 3\n(Determinista por similitud y popularidad)"]:::fallback
        
        SQL_QUERY --> PROMPT_BUILDER
        AUTH -.-> PROMPT_BUILDER
        PROMPT_BUILDER --> ROUTER
        ROUTER -->|Reasoning model| LLM_REASONING
        ROUTER -->|Standard model| LLM_STANDARD
        LLM_REASONING --> CASCADE
        LLM_STANDARD --> CASCADE
        CASCADE -->|Error/Cuota agotada en todas las keys| L3_FALLBACK
    end

    subgraph SALIDA["Hidratación y Respuesta"]
        HYDRATE["Paso 5: Hidratación (TitleCardResponse)\nInyecta variety_level, badges de estreno,\nestados y streaming"]:::service
        CASCADE -->|Respuesta LLM válida| HYDRATE
        L3_FALLBACK -->|Candidatos heurísticos| HYDRATE
    end

    %% Conexiones Globales
    UI -- "Request JSON" --> ENDPOINT
    ENDPOINT --> VALIDATOR
    HYDRATE -- "Response Estructurada" --> ENDPOINT
    ENDPOINT --> UI
