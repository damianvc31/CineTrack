# CineTrack — plantilla de variables de entorno
# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NUNCA se sube a git (ya está en .gitignore).

# --- Base de datos ---
DATABASE_URL=postgresql://usuario:password@localhost:5432/cinetrack

# --- TMDB ---
# Usar el Read Access Token (v4, Bearer) — mismo acceso que la API Key clásica (v3),
# pero sirve para ambas versiones de la API con un solo método, y es el formato más
# moderno/seguro (va en el header, no en la URL). Confirmado en la documentación oficial
# de TMDB: los dos dan el mismo nivel de acceso, elegir el token no tiene desventajas.
# Guardar SOLO el valor del token, sin la palabra "Bearer" adelante — eso lo agrega
# el código al armar el encabezado HTTP (Authorization: Bearer <esto>), no va en el .env.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=en-US
TMDB_INGEST_MOVIES_TARGET=1000
TMDB_INGEST_SERIES_TARGET=1000
TMDB_MIN_VOTE_COUNT=100
TMDB_CAST_LIMIT=15
TMDB_CREW_WRITERS_LIMIT=3
TMDB_DAILY_SYNC_DAYS_WINDOW=15
TMDB_CHANGES_HOURS_WINDOW=48
TMDB_DAILY_SYNC_POP_THRESHOLD=10.0
TMDB_INGEST_PRIORITY=popular_first
TMDB_REVIEWS_PER_TITLE_LIMIT=20
TMDB_ALLOW_UNRELEASED=false

# --- Autenticación y Seguridad ---
# Secreto para firmar sesiones/tokens JWT del login.
# Generar uno random y largo, no un valor fácil de adivinar.
AUTH_SECRET_KEY=

# Clave administrativa para endpoints de mantenimiento (/api/v1/admin/sync/*) y cron jobs.
# Pasar vía header HTTP 'X-Admin-Key: <clave>' o usar token JWT de usuario con es_admin=True.
ADMIN_API_KEY=cinetrack-dev-admin-secret-key

# --- Proveedor de IA para el recomendador (Híbrido: Gemini Primario + Groq Fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_RECOMMENDER_PRIMARY=gemini

# --- Home Sections & Pools Configuration ---
HOME_SECTION_SAMPLE_SIZE=10
HOME_NEW_RELEASES_DAYS=30
HOME_TRENDING_DAYS=90
HOME_TRENDING_MIN_POPULARITY_PERCENTILE=0.80
HOME_CLASSICS_MIN_YEARS=20
HOME_CLASSICS_MIN_RATING=7.5
HOME_CLASSICS_MIN_VOTES=500
HOME_CLASSICS_POOL_SIZE=50
HOME_TOP_RATED_MIN_VOTES=100
HOME_TOP_RATED_POOL_SIZE=100
HOME_GENRE_POOL_SIZE=100
HOME_GENRE_MIN_TITLES_FOR_CAROUSEL=10

# --- Entorno ---
ENVIRONMENT=development

# --- Frontend (Vite) ---
# Por defecto es 'http://localhost:8000/api/v1' si no se especifica
VITE_API_URL=http://localhost:8000/api/v1
